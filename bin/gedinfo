#!/usr/bin/env python3
"""Wrapper script to run the gedinfo package without invoking `python -m`.

Place this directory on your PATH or call it directly (`./bin/gedinfo`).
"""

import sys
from pathlib import Path

# Add the parent directory to sys.path so gedinfo can be imported
sys.path.insert(0, str(Path(__file__).parent.parent))

from gedinfo.cli import main


if __name__ == "__main__":
    # argparse already handles sys.exit codes internally
    sys.exit(main())
